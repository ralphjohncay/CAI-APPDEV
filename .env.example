# Production (default in src/config/api.js — no env needed for Railway)
# EXPO_PUBLIC_API_URL=https://finalscay-production.up.railway.app

# Local Symfony (symfony serve on port 8000)
# EXPO_PUBLIC_API_URL=http://127.0.0.1:8000

# Android emulator → host machine
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# Physical device on same Wi‑Fi (your PC LAN IP)
# EXPO_PUBLIC_API_URL=http://192.168.1.42:8000

EXPO_PUBLIC_API_URL=https://finalscay-production.up.railway.app
